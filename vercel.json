{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/*.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/adsgram/reward",
            "destination": "/api/ops?op=adsgramReward"
        },
        {
            "source": "/api/broadcastWorker",
            "destination": "/api/ops?op=broadcastWorker"
        },
        {
            "source": "/api/broadcastStatus",
            "destination": "/api/ops?op=broadcastStatus"
        },
        {
            "source": "/api/broadcastTick",
            "destination": "/api/ops?op=broadcastTick"
        },
        {
            "source": "/api/admin/check-chats",
            "destination": "/api/ops?op=check-chats"
        },
        {
            "source": "/api/admin/set-webhook",
            "destination": "/api/ops?op=set-webhook"
        },
        {
            "source": "/api/admin/setup-indexes",
            "destination": "/api/ops?op=setup-indexes"
        },
        {
            "source": "/api/cron/weeklyReferral",
            "destination": "/api/ops?op=weeklyReferral"
        }
    ],
    "headers": [
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        },
        {
            "source": "/i18n.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        },
        {
            "source": "/css/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        }
    ]
}
